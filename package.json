{
  "name": "@theotherwillembotha/node-red-cluster",
  "version": "0.0.55",
  "description": "Node-RED clustering plugin - connect multiple Node-RED instances into a coordinated cluster using NATS JetStream for message transport and NATS KV for shared state.",
  "main": "./build/index.js",
  "exports": "./build/index.js",
  "author": "Willem Botha (@theotherwillembotha)",
  "license": "ISC",
  "keywords": [
    "node-red",
    "cluster",
    "distributed",
    "nats",
    "jetstream",
    "messaging"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run clean && tsc && npm run generate-nodes && npm run copy-files",
    "clean": "rm -rf ./build",
    "generate-nodes": "node build/GenerateNodes.js",
    "copy-files": "cp -r ./icons ./build/"
  },
  "files": [
    "build/",
    "documentation/",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theotherwillembotha/nodered_cluster.git"
  },
  "bugs": {
    "url": "https://github.com/theotherwillembotha/nodered_cluster/issues"
  },
  "homepage": "https://github.com/theotherwillembotha/nodered_cluster#readme",
  "engines": {
    "node": ">=18",
    "nodered": ">=4.0.0"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@theotherwillembotha/node-red-plugincore": "^0.0.55"
  },
  "devDependencies": {
    "@theotherwillembotha/node-red-plugincore": "../nodered_plugincore",
    "@types/node": "^25.9.1",
    "@types/node-red": "~1.3.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "cluster": "./build/Nodes.js"
    },
    "plugins": {
      "cluster": "./build/Plugins.js"
    }
  }
}
